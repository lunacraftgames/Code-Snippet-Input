<Window x:Class="CodeSnippetInput.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CodeSnippetInput.Models"
        Title="{DynamicResource MainWindowTitle}" Icon="Assets/CodeSnippetInput.ico"
        Height="760" Width="1180" MinHeight="600" MinWidth="920"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <WrapPanel Margin="0,0,0,8">
        <Button x:Name="ToggleExpansionButton" Click="ToggleExpansion_Click" Content="{DynamicResource ButtonEnableGlobalExpansion}" />
        <Button Click="AddContext_Click" Content="{DynamicResource ButtonNewContext}" />
        <Button Click="DeleteContext_Click" Content="{DynamicResource ButtonDeleteContext}" />
        <Button Click="AddTemplate_Click" Content="{DynamicResource ButtonNewTemplate}" />
        <Button Click="DeleteTemplate_Click" Content="{DynamicResource ButtonDeleteTemplate}" />
        <Button Click="Save_Click" Content="{DynamicResource ButtonSave}" />
        <Button Click="OpenWebsite_Click" Content="{DynamicResource ButtonOfficialWebsite}"
                ToolTip="{DynamicResource TooltipOfficialWebsite}" />
      </WrapPanel>
      <DockPanel>
        <WrapPanel DockPanel.Dock="Left">
          <Button Click="ImportConfig_Click" Content="{DynamicResource ButtonImportJson}" />
          <Button Click="ImportIntelliJ_Click" Content="{DynamicResource ButtonImportTemplates}" />
          <Button Click="ExportConfig_Click" Content="{DynamicResource ButtonExportJson}" />
          <Button Click="ExportIntelliJ_Click" Content="{DynamicResource ButtonExportTemplates}" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource LabelLanguage}" VerticalAlignment="Center" Margin="12,0,8,0" />
          <ComboBox x:Name="UiLanguageCombo" Width="130" DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                    SelectionChanged="UiLanguageCombo_SelectionChanged" />
          <TextBlock Text="{DynamicResource LabelCurrentContext}" VerticalAlignment="Center" Margin="12,0,8,0" />
          <ComboBox Width="170" ItemsSource="{Binding ContextChoices}"
                    SelectedItem="{Binding ActiveContextDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="#FFD0D5DD" BorderThickness="1" CornerRadius="4" Padding="4">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="8,6,8,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource TreeTitle}" FontWeight="SemiBold" FontSize="15"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{DynamicResource ButtonSelectAll}" Click="SelectAll_Click"
                    Margin="8,0,4,0" Padding="8,3" ToolTip="{DynamicResource TooltipSelectAll}" />
            <Button Grid.Column="2" Content="{DynamicResource ButtonSelectNone}" Click="SelectNone_Click"
                    Margin="0" Padding="8,3" ToolTip="{DynamicResource TooltipSelectNone}" />
          </Grid>
          <TreeView x:Name="TemplateTree" ItemsSource="{Binding ContextGroups}"
                    SelectedItemChanged="TemplateTree_SelectedItemChanged" BorderThickness="0">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="2" />
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
              <HierarchicalDataTemplate DataType="{x:Type models:ContextGroupViewModel}" ItemsSource="{Binding Templates}">
                <Grid Width="330">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsThreeState="True" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{DynamicResource TooltipToggleContext}" />
                  <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                           FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="2"
                           ToolTip="{DynamicResource TooltipRenameContext}" />
                  <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat=({0})}" Foreground="#FF7A8290"
                             VerticalAlignment="Center" Margin="8,0,4,0" />
                  <Button Grid.Column="3" Content="{DynamicResource ButtonDelete}" Tag="{Binding}" Click="DeleteContext_Click"
                          Margin="6,0,0,0" Padding="6,2" ToolTip="{DynamicResource TooltipDeleteContext}" />
                </Grid>
              </HierarchicalDataTemplate>
              <DataTemplate DataType="{x:Type models:SnippetTemplate}">
                <Grid Width="300">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Abbreviation}" FontFamily="Cascadia Mono, Consolas"
                             FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="#FF737B88"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </TreeView.Resources>
          </TreeView>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel DataContext="{Binding SelectedTemplate}">
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="{DynamicResource EditorTitle}" Margin="0,0,0,16" />

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource LabelContext}" />
            <ComboBox Grid.Column="1" IsEditable="True"
                      ItemsSource="{Binding DataContext.AvailableContexts, RelativeSource={RelativeSource AncestorType=Window}}"
                      Text="{Binding Context, UpdateSourceTrigger=LostFocus}" LostFocus="TemplateContext_LostFocus" />
          </Grid>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource LabelAbbreviation}" />
            <TextBox Grid.Column="1" Text="{Binding Abbreviation, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource LabelDescription}" />
            <TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>

          <CheckBox Content="{DynamicResource LabelEnabled}" IsChecked="{Binding IsEnabled}" Margin="0,0,0,12" />

          <TextBlock Text="{DynamicResource LabelBody}" />
          <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono, Consolas" FontSize="14" Height="270" Margin="0,5,0,12" />

          <TextBlock Text="{DynamicResource LabelVariables}" />
          <TextBox Text="{Binding DataContext.VariableDefinitions, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" Height="94" Margin="0,5,0,12" />

          <TextBlock Text="{DynamicResource LabelTemplateContexts}" />
          <TextBox Text="{Binding DataContext.ContextDefinitions, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,5,0,12" />

          <Border Background="#FFF7F7F7" BorderBrush="#FFD0D0D0" BorderThickness="1" Padding="12">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{DynamicResource HelpCandidatesTitle}" />
              <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="{DynamicResource HelpCandidatesText}" />
              <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF666666"
                         Text="{DynamicResource HelpLiteralDollarText}" />
              <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF666666"
                         Text="{DynamicResource HelpExportText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="#FF555555" Text="{Binding StatusText}" />
  </Grid>
</Window>
