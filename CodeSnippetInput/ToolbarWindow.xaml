<Window x:Class="CodeSnippetInput.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ToolbarTitle}" Width="390" Height="56"
        Icon="Assets/CodeSnippetInput.ico"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Opacity="0" Loaded="Window_Loaded" Closed="Window_Closed">
  <Border CornerRadius="10" Background="#FDFEFF" BorderBrush="#B8C2D0" BorderThickness="1" Padding="7">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.30" Color="#27364A" />
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="34" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#1967D2" CornerRadius="7" Margin="0,0,8,0"
              MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" ToolTip="{DynamicResource ToolbarDragTooltip}">
        <Image Source="Assets/CodeSnippetInput.png" Width="30" Height="30" Stretch="Uniform" />
      </Border>
      <TextBlock Grid.Column="1" Text="Context" VerticalAlignment="Center" Foreground="#4A5568" Margin="0,0,7,0" />
      <ComboBox x:Name="ContextCombo" Grid.Column="2" MinWidth="150" VerticalContentAlignment="Center"
                SelectionChanged="ContextCombo_SelectionChanged" />
      <Button Grid.Column="3" Content="{DynamicResource ToolbarManager}" Click="OpenManager_Click" Margin="8,0,4,0" Padding="10,5"
              ToolTip="{DynamicResource ToolbarManagerTooltip}" />
      <Button Grid.Column="4" Content="×" Click="Close_Click" Margin="0" Padding="8,4"
              ToolTip="{DynamicResource ToolbarCloseTooltip}" />
    </Grid>
  </Border>
</Window>
